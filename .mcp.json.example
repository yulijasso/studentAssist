{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://campus_assist:campus_assist@localhost:5432/campus_assist"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "redis": {
      "command": "uvx",
      "args": ["mcp-server-redis", "--url", "redis://localhost:6379/0"]
    }
  }
}
